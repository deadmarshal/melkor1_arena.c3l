module melkor1_arena;

<* Bump allocator arena. *>
alias Arena = void;

<* Returns a new arena with the specified `capacity`.
 If `capacity` is 0, a default size of `DEFAULT_BUF_CAP` is used.
 If `buf` is `nullptr`, a memory pool of the specified `capacity` is
 allocated internally. Else if `capacity` is 0, a default size of 
 `DEFAULT_BUF_CAP` is used.
 
 On allocation failure, or if `buf` is a non-null pointer and `capacity` is 0,
 returns `nullptr`. 
 *
 Passing a `buf` that is smaller than the specified `capacity` would invoke
 undefined behavior. *>
fn Arena *arena_new(void *buf,usz capacity) @cname("arena_new");
fn void arena_destroy(Arena *arena) @cname("arena_destroy");
fn void arena_reset(Arena *arena) @cname("arena_reset");
fn void *arena_alloc(Arena *arena,usz alignment,usz size) @cname("arena_alloc");
fn Arena *arena_resize(Arena *arena,
		       void *buf,
		       usz capacity) @cname("arena_resize");
fn void *arena_allocarray(Arena *arena,
			  usz alignment,
			  usz nmemb,
			  usz size) @cname("arena_allocarray");
fn CBool arena_realloc(Arena *arena,usz size) @cname("arena_realloc");
fn usz arena_pool_capacity(Arena *arena) @cname("arena_pool_capacity");
fn usz arena_allocated_bytes(Arena *arena) @cname("arena_allocated_bytes");
fn usz arena_allocated_bytes_including_metadata(Arena *arena) @cname("arena_allocated_bytes_including_metadata");

